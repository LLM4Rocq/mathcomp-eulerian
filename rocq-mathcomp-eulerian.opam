opam-version: "2.0"
version: "0.1.0"
synopsis: "Eulerian numbers and descent-set statistics in Rocq/MathComp"
description: """
A Mathematical Components development of Eulerian numbers and the
descent-set statistics of permutations, including Stanley (Enumerative
Combinatorics I) Corollary 1.6.5 — among all prescribed descent sets, the
alternating one maximises the number of permutations (the lemma
[beta_alt_max]).  Installs the library under the logical name
[mathcomp_eulerian]; a self-contained formal-power-series sub-library is
installed under [mathcomp_fps].
"""
maintainer: "Marc Lelarge <marc.lelarge@gmail.com>"
authors: "LLM4Rocq"
license: "Apache-2.0"
homepage: "https://github.com/LLM4Rocq/mathcomp-eulerian"
bug-reports: "https://github.com/LLM4Rocq/mathcomp-eulerian/issues"
dev-repo: "git+https://github.com/LLM4Rocq/mathcomp-eulerian.git"

build: [
  [ make "-j%{jobs}%" ]
]
install: [
  [ make "install" ]
]

depends: [
  "rocq-core" {>= "9.0"}
  "rocq-mathcomp-ssreflect" {>= "2.0.0"}
  "rocq-mathcomp-algebra" {>= "2.0.0"}
  "rocq-mathcomp-classical" {>= "1.0.0"}
]
