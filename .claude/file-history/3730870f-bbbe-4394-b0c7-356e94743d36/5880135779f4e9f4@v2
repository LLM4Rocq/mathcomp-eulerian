    exact: leq_trans (leq_sub2r _ Hsz)
      (leq_subr _ _).
  set i' := i - m - 1.
  set j' := j - m - 1.
  have Hi'j' : i' < j'.
    rewrite /i' /j'.
    by rewrite !subnS ltn_sub2r // subn_gt0.
  have Hws_i' :
    window_size i' (drop m.+1 s) =
