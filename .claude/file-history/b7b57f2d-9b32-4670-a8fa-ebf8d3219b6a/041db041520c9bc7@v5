(*                                                                            *)
(* Proof outline (the infrastructure above gives everything needed):         *)
(*                                                                            *)
(* eulerian n.+1 k.+1 = \sum_(σ : {perm 'I_n.+2}) [des σ == k.+1]             *)
(* = \sum_((τ, p)) [des (insert_max_perm τ p) == k.+1]  (via insert_max_perm_bij) *)
(* = \sum_τ \sum_p [des (insert_max_perm τ p) == k.+1]                        *)
(* = \sum_τ ([des τ + 1 == k.+1]                                              *)
(*         + \sum_(j : 'I_n) [des τ + ~~ is_descent τ j == k.+1]              *)
(*         + [des τ == k.+1])                                                 *)
(* = \sum_τ ([des τ == k] + [des τ == k.+1] * des τ                            *)
(*         + [des τ == k] * (n - des τ) + [des τ == k.+1])                    *)
(* = \sum_τ ((n.+1 - k) * [des τ == k] + k.+2 * [des τ == k.+1])              *)
(* = (n.+1 - k) * eulerian n k + k.+2 * eulerian n k.+1.                      *)

Lemma eulerian_rec n k :
  eulerian n.+1 k.+1 = k.+2 * eulerian n k.+1 + (n.+1 - k) * eulerian n k.
Admitted.
