(* ----- M5.5 Main theorem: Fact #3 (axiom) ---------------------------------- *)
(* Φ_w(a+b, ab+ba) = Σ_{v∈[w]} u_{D(v)}.                                     *)
(* Stated as multiset equality: the sorted list of char_mono over all          *)
(* apply_psis S w (S ranging over subsets of internal vertices) equals the     *)
(* sorted expansion of the cd-word phi_w w.                                    *)
(*                                                                             *)
(* Proof sketch (M5_FACT3_INFORMAL.md sections 2-3):                           *)
(* 1. By tree-shape invariance, is_internal and has_left_child are constant    *)
(*    across [w], so phi_w is well-defined for the class.                      *)
(* 2. The affected position sets A(i) are pairwise disjoint (LR_pred_is_      *)
(*    endpoint + disjointness argument).                                       *)
(* 3. Each internal vertex contributes an independent factor: (a+b) for       *)
(*    Case R (toggle at position i), (ab+ba) for Case LR (swap at {i-1,i}).   *)
(* 4. Endpoints contribute fixed letters, but are absorbed by the d-vertex    *)
(*    pairing (endpoint_implies_next_has_left_child), so deleting e-factors    *)
(*    on both sides yields the identity.                                       *)
(* 5. The product over internal vertices in position order gives exactly       *)
(*    Φ_w(c:=a+b, d:=ab+ba).                                                  *)

Axiom fact3 : forall (w : seq nat),
  uniq w ->
  sort leq_seqb [seq char_mono (apply_psis ss w) | ss <- powerset_internal w]
  =
  sort leq_seqb (expand_cde (phi_w w)).

