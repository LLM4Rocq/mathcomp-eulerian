(* ----- M5.4 Disjointness of affected position sets (axiom) ------------------ *)
(* For distinct internal vertices i and j, the affected descent-position sets  *)
(* A(i) and A(j) are disjoint. A(i) = {i} for Case R, A(i) = {i-1, i} for    *)
(* Case LR. The proof (M5_FACT3_INFORMAL.md section 2.2) relies on: if vertex *)
(* i is Case LR, then vertex i-1 is an endpoint (hence not internal).         *)
(* This is the key structural fact enabling the product decomposition.         *)

Axiom LR_pred_is_endpoint : forall (i : nat) (w : seq nat),
  uniq w -> 0 < i -> is_internal i w -> has_left_child i w ->
  ~~ is_internal i.-1 w.

