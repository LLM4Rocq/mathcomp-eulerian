Lemma min_val_drop j w :
  w <> [::] ->
  foldr minn (head 0 w) (behead w) \notin take j w ->
  j < size w ->
  foldr minn (head 0 (drop j w)) (behead (drop j w)) =
  foldr minn (head 0 w) (behead w).
Proof.
